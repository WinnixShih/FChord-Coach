# Which Vision-Language Model provider to use for suggestion generation.
# Valid values: gemini | anthropic | openai
# If unset or the key is missing, the backend falls back to a generic canned message.
VLM_PROVIDER=gemini

# API key for the selected provider. Get one at:
#   gemini    -> https://aistudio.google.com/app/apikey
#   anthropic -> https://console.anthropic.com/settings/keys
#   openai    -> https://platform.openai.com/api-keys
# Rate-limited to 2 calls/minute regardless of provider.
VLM_API_KEY=your_api_key_here
